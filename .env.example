# ── Application ───────────────────────────────────────────────────
APP_NAME="Pronunciation Assessment API"
APP_VERSION="1.0.0"
DEBUG=false

# ── Model ─────────────────────────────────────────────────────────
# Tên model trên HuggingFace Hub, hoặc đường dẫn local
# MODEL_NAME=facebook/wav2vec2-base-960h
# MODEL_NAME=HuynhPhamN/working
MODEL_NAME=HuynhPhamN/new_model
MODEL_CACHE_DIR=./model_cache

# ── Audio ─────────────────────────────────────────────────────────
SAMPLE_RATE=16000
MAX_AUDIO_DURATION_SEC=30.0
MAX_FILE_SIZE_MB=10.0

# Debug: mỗi request /recognize lưu 2 file WAV (trước/sau preprocess) + log đường dẫn
DEBUG_SAVE_AUDIO=true
DEBUG_AUDIO_DIR=./debug_audio
# true = tự phát/mở file (cần sounddevice hoặc Windows mở app mặc định)
DEBUG_PLAY_AUDIO=false

# ── Scoring thresholds ────────────────────────────────────────────
SCORE_EXCELLENT=85.0
SCORE_GOOD=70.0
SCORE_FAIR=50.0
